@host = http://localhost:5000
@contentType = application/json
@studentToken = {{loginStudent.response.body}}

# ID анкеты "Оценка преподавателя" (из Seeder'а, нужно посмотреть в базе или через GET /forms)
# Обычно Seeder генерирует GUID, поэтому сначала сделайте GET /forms и скопируйте ID сюда
@formId = <ВСТАВЬТЕ_GUID_АНКЕТЫ_СЮДА>

# ID вопроса (также нужно взять из GET /forms/{id})
@questionId_Rating = <ВСТАВЬТЕ_GUID_ВОПРОСА_С_ВЕСОМ>
@questionId_Text = <ВСТАВЬТЕ_GUID_ТЕКСТОВОГО_ВОПРОСА>

# ==========================================
# 1. Отправка ответов (Успешный сценарий)
# ==========================================
POST {{host}}/submissions
Authorization: Bearer {{studentToken}}
Content-Type: {{contentType}}

{
  "formId": "{{formId}}",
  "userId": "3fa85f64-5717-4562-b3fc-2c963f66afa6", 
  "disciplineId": null,
  "educationForm": "ДФПО",
  "answers": [
    {
      "questionId": "{{questionId_Rating}}",
      "numericValue": 8,
      "weight": 10
    },
    {
      "questionId": "{{questionId_Text}}",
      "value": "Интернет работает отлично!"
    }
  ]
}
# Примечание: userId в реальном приложении берется из токена, 
# но в вашей команде CreateSubmissionCommand он передается явно. 
# Убедитесь, что передаете ID того юзера, под которым залогинились.

###

# ==========================================
# 2. Ошибка валидации (Оценка > Веса)
# ==========================================
POST {{host}}/submissions
Authorization: Bearer {{studentToken}}
Content-Type: {{contentType}}

{
  "formId": "{{formId}}",
  "userId": "...", 
  "answers": [
    {
      "questionId": "{{questionId_Rating}}",
      "numericValue": 10,
      "weight": 5
    }
  ]
}
# Ожидается: 400 Bad Request ("Score cannot be greater than Weight")

###

# ==========================================
# 3. Просмотр моих ответов (История)
# ==========================================
GET {{host}}/submissions?formId={{formId}}
Authorization: Bearer {{studentToken}}