{
  "ConnectionStrings": {
    "Database": "Host=postgres;Port=5432;Database=questionnaire-vfbsac;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "ServerUrl": "http://seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Jwt": {
    "_Secret": "Do not commit a real key. Set it locally with: dotnet user-secrets set \"Jwt:Secret\" \"<random-32+-char-value>\" (project src/Web.Api). On deployed services set the Jwt__Secret environment variable.",
    "Secret": "",
    "Issuer": "questionnaire-vfbsac",
    "Audience": "developers",
    "ExpirationInMinutes": 60
  }
}
