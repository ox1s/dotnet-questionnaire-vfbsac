# ==========================================
# 1. Получить unified analytics report
# ==========================================
POST {{host}}/reports/analytics
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "formId": "{{formId}}",
  "slices": [
    {
      "label": "Текущий семестр",
      "dateFrom": "2026-01-01",
      "dateTo": "2026-04-01"
    }
  ]
}

